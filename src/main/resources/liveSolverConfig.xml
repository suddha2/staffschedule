<?xml version="1.0" encoding="UTF-8"?>
<!--
  Live / continuous real-time planning solver config (P2).

  Differs from the batch solverConfig.xml in three ways:
    * <daemon>true</daemon> — the solver does NOT return after reaching its best
      score; it stays alive and re-optimises when problem changes are fed in
      (added in later phases). It runs until terminateEarly() is called.
    * No <termination> — a daemon solver is stopped explicitly, not on a clock.
    * <moveThreadCount>NONE</moveThreadCount> — single-threaded per session so N
      concurrent live sessions don't each grab a pool of cores. Idle sessions are
      evicted by LiveSolverSessionService to reclaim the thread.

  Constraints, phases and entity/solution classes are identical to the batch
  config so a live rota is scored the same way as a batch one.
-->
<solver>
    <solutionClass>com.midco.rota.model.Rota</solutionClass>
    <entityClass>com.midco.rota.model.WorkShiftAssignment</entityClass>
    <entityClass>com.midco.rota.model.FollowerShiftAssignment</entityClass>

    <daemon>true</daemon>

    <scoreDirectorFactory>
        <constraintProviderClass>com.midco.rota.opt.RotaConstraintProvider</constraintProviderClass>
        <constraintMatchEnabled>false</constraintMatchEnabled>
        <indictmentEnabled>false</indictmentEnabled>
    </scoreDirectorFactory>

    <bestScoreFeasible>0</bestScoreFeasible>
    <moveThreadCount>NONE</moveThreadCount>

    <!-- PHASES: none configured, so OptaPlanner runs its default construction heuristic
         + local search. Earlier phase blocks here were wrapped in <phase>, which OptaPlanner
         does not read, so they never took effect. On 2026-10-13 the intended phases
         (permanents first, then zero-hours, then change+swap with tabu/late acceptance) were
         fixed and benchmarked against the defaults on Barnet (req 248) and Hertfordshire
         (req 242), 120 s each: not consistently better (lower score on Barnet; higher score
         but 17 more unfilled shifts on Hertfordshire), so the defaults stay. To try custom
         phases, declare <constructionHeuristic>/<localSearch> directly under <solver> and
         re-run that comparison before switching. -->
</solver>
