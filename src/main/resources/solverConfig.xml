<solver>
    <solutionClass>com.midco.rota.model.Rota</solutionClass>
    <!-- Planning entity hierarchy: work shifts hold the genuine employee variable;
         SLEEP_IN holds a shadow that mirrors its paired LONG_DAY. Only the concrete
         subclasses are entities; the non-entity superclass ShiftAssignment is what
         the ~40 constraints forEach() over. -->
    <entityClass>com.midco.rota.model.WorkShiftAssignment</entityClass>
    <entityClass>com.midco.rota.model.FollowerShiftAssignment</entityClass>
    <!-- REPRODUCIBLE: no per-step integrity assertions (FAST_ASSERT is a debug
         mode that runs ~10-100x slower), but still deterministic for a fixed
         seed so runs stay comparable. FAST_ASSERT was silently throttling every
         solve; switching it lets local search actually explore the neighbourhood
         within the time budget. -->
    <environmentMode>REPRODUCIBLE</environmentMode>
    
    <scoreDirectorFactory>
        <constraintProviderClass>com.midco.rota.opt.RotaConstraintProvider</constraintProviderClass>
        <constraintMatchEnabled>false</constraintMatchEnabled>
        <indictmentEnabled>false</indictmentEnabled>
    </scoreDirectorFactory>

    <termination>
        <secondsSpentLimit>120</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>60</unimprovedSecondsSpentLimit>
    </termination>

    <bestScoreFeasible>0</bestScoreFeasible>
    <moveThreadCount>AUTO</moveThreadCount>

    <!-- PHASE 1: Permanent employees -->
    <phase>
        <constructionHeuristic>
            <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>
            <entitySorterManner>DECREASING_DIFFICULTY</entitySorterManner>
            <valueSorterManner>DECREASING_STRENGTH</valueSorterManner>
            <valueSelector>
                <variableName>employee</variableName>
                <filterClass>com.midco.rota.opt.PermanentEmployeeFilter</filterClass>
            </valueSelector>
        </constructionHeuristic>
    </phase>

    <!-- PHASE 2: Zero-hours employees -->
    <phase>
        <constructionHeuristic>
            <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>
            <entitySorterManner>DECREASING_DIFFICULTY</entitySorterManner>
            <valueSorterManner>DECREASING_STRENGTH</valueSorterManner>
            <valueSelector>
                <variableName>employee</variableName>
                <filterClass>com.midco.rota.opt.ZeroHoursEmployeeFilter</filterClass>
            </valueSelector>
        </constructionHeuristic>
    </phase>

    <!-- PHASE 3: local search over ALL assignments (permanents included).
         Previously this only re-decided zero-hours assignments
         (ZeroHoursAssignmentFilter), which froze permanent placements from the
         construction heuristic. Backtest analysis showed ~90% of "not the usual
         carer" cases were a permanent regular sitting idle that local search
         could not move. Change moves (now unfiltered) let an idle regular take a
         slot a non-regular holds; swap moves rebalance two assignments. Both are
         scoped to the employee variable, so SLEEP_IN shadow entities are
         untouched (their employee is a shadow, not a genuine variable). -->
    <phase>
        <localSearch>
            <acceptor>
                <entityTabuSize>7</entityTabuSize>
                <lateAcceptanceSize>400</lateAcceptanceSize>
            </acceptor>
            <unionMoveSelector>
                <changeMoveSelector>
                    <valueSelector>
                        <variableName>employee</variableName>
                        <cacheType>PHASE</cacheType>
                        <selectionOrder>SHUFFLED</selectionOrder>
                    </valueSelector>
                </changeMoveSelector>
                <swapMoveSelector>
                    <variableNameInclude>employee</variableNameInclude>
                </swapMoveSelector>
            </unionMoveSelector>
        </localSearch>
    </phase>
</solver>